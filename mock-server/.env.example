# Copy this file to ".env" (same folder) before running the server.
# ".env" is where real/secret values live — never commit it to GitHub.

# Port the local server runs on. 3000 is fine unless it's already in use.
PORT=3000

# Optional but recommended once your server is public (via ngrok/Render):
# a shared secret that Vapi must send back in a custom header
# ("x-webhook-secret") on every request. Prevents random internet traffic
# from hitting your webhook and triggering fake tool calls.
# Leave blank while testing locally if you want.
WEBHOOK_SECRET=change-this-to-a-random-string
